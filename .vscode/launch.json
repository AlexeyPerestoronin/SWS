    "version": "0.2.0",
    "console": "integratedTerminal",
    "configurations": [
        {
            "name": "Debug invoke-task",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/Scripts/invoke.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "projects.monopoly.prepare-wood-doc"
                //"check.body-naming", "--path=C:/MyLife/SWP/Projects/РАЗНОЕ/Монополия/Карта.SLDPRT", "--repair"
                // "export.step", "--path=C:/MyLife/SWP/Projects/МАСТЕРСКАЯ/разное/Кронштейн-Лампы-Электрощитка/Кронштейн-Лампы-Электрощитка.SLDPRT"
            ],
        },
        // "projects.casket.prepare-metal-manufacturing-doc"
        // "projects.punch-guide-holder.prepare-metal-manufacturing-doc"
        {
            "name": "Profile invoke-task",
            "type": "debugpy",
            "request": "launch",
            "module": "cProfile", // Указываем VS Code запустить профилировщик как модуль
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "-o", "${workspaceFolder}/invoke_task.prof", // Файл отчета
                "-m", "invoke", "projects.monopoly.prepare-wood-doc",
            ],
            "console": "integratedTerminal",
        }

    ]
}