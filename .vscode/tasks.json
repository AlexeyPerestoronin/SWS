{
    "version": "2.0.0",
    "presentation": {
        "reveal": "always",
        "panel": "shared"
    },
    "problemMatcher": [],
    "tasks": [
        {
            "label": "YAPF",
            "type": "shell",
            "group": "none",
            "command": "${workspaceFolder}/.venv/Scripts/yapf.exe",
            "args": [
                "--style",
                "${workspaceFolder}/.style.yapf",
                "--recursive",
                "--in-place",
                "--parallel",
                "${workspaceFolder}",
                "C:/MyLife/SWP/Projects",
                "--exclude",
                "${workspaceFolder}/.venv/**"
            ],
        },
        {
            "label": "Check and repair body naming",
            "type": "shell",
            "group": "none",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                    "invoke",
                        "check.body-naming",
                            "--path=C:/MyLife/Monopoly 2.0/проектирование/игровое поле/Карта-v2.SLDPRT",
                            "--repair"
            ],
        },
        {
            "label": "Export step",
            "type": "shell",
            "group": "none",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                    "invoke",
                        "export.step",
                            "--path=C:/MyLife/Monopoly 2.0/проектирование/игровое поле/Карта-v2.SLDPRT"
            ],
        }
    ]
}